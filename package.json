    "express-rate-limit": "^8.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.3.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "shx": "^0.4.0"
  }
